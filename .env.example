# ===========================
# APPLICATION
# ===========================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===========================
# DATABASE
# ===========================
DATABASE_URL="postgresql://notaria_user:notaria_pass@localhost:5432/notaria_db?schema=public"

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_64_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_64_chars
JWT_REFRESH_EXPIRATION=7d

# ===========================
# BCRYPT
# ===========================
BCRYPT_ROUNDS=12

# ===========================
# CORS
# ===========================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ===========================
# RATE LIMITING
# ===========================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===========================
# FILE UPLOAD
# ===========================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
# 10MB en bytes

# ===========================
# LOGS
# ===========================
LOG_LEVEL=debug
LOG_DIR=./logs

# ===========================
# SYSTEM
# ===========================
SYSTEM_NAME=Notaria Sistema
SYSTEM_VERSION=1.0.0
