generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum RoleType {
  SUPER_ADMIN
  NOTARIO
  MATRIZADOR
  ARCHIVADOR
}

enum ArchiveType {
  P
  D
  A
  C
  O
}

enum NotificationType {
  INFORMATIVA
  URGENTE
  RECORDATORIO
  ALERTA
}

enum TaskPriority {
  ALTA
  MEDIA
  BAJA
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

// ─── AUTH / USERS ─────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  isActive  Boolean   @default(true) @map("is_active")
  // true = el usuario NO puede descargar / imprimir / abrir en pestaña nueva los PDF
  pdfDownloadDisabled Boolean @default(false) @map("pdf_download_disabled")
  // Contador de intentos de login fallidos consecutivos. Se resetea a 0 tras un login correcto.
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  // Si no es null, la cuenta está bloqueada por exceso de intentos fallidos.
  // Solo un SUPER_ADMIN o NOTARIO puede desbloquearla (POST /auth/unlock-account).
  lockedAt            DateTime? @map("locked_at")
  // Época de sesión. Se incrementa en cada login y en cambios de contraseña.
  // El access token lleva este valor como claim `epoch`; si no coincide con el de
  // la BD, el token se rechaza → fuerza sesión única por usuario (un solo dispositivo).
  sessionEpoch        Int      @default(0) @map("session_epoch")
  // Marca de última actividad autenticada. Se actualiza en cada request válido
  // (como mucho 1 vez/min) y en /auth/refresh. Sirve para saber si la sesión
  // sigue "viva": un segundo login se rechaza mientras exista un refresh token
  // vigente y lastSeenAt esté dentro de la ventana SESSION_IDLE_MINUTES.
  // null = sin sesión / sesión abandonada → el siguiente login puede tomar su lugar.
  lastSeenAt         DateTime? @map("last_seen_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  userRoles         UserRole[]
  refreshTokens     RefreshToken[]
  createdArchives   Archive[]      @relation("ArchiveCreatedBy")
  updatedArchives   Archive[]      @relation("ArchiveUpdatedBy")
  logs              Log[]
  sentNotifications Notification[] @relation("NotificationSender")
  sentTasks         Task[]         @relation("TaskSender")
  receivedTasks     Task[]         @relation("TaskRecipient")
  uafeForms         UafeForm[]     @relation("UafeFilledBy")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  // Época de sesión en la que se emitió este refresh token. En /auth/refresh, si
  // no coincide con User.sessionEpoch significa que hubo un login más nuevo en
  // otro dispositivo → se rechaza sin escalar a "replay attack".
  sessionEpoch Int    @default(0) @map("session_epoch")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  // Composite index for active-session queries in generateTokens and refreshTokens
  @@index([userId, isRevoked, expiresAt])
  @@map("refresh_tokens")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  type        RoleType
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([type])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─── ARCHIVES ─────────────────────────────────────────────────────────────────

model Archive {
  id           String      @id @default(uuid())
  // Uniqueness among active rows is enforced by the partial index
  // "archives_code_unique_active" (WHERE deleted_at IS NULL) created via raw
  // migration — Prisma does not support partial unique indexes natively.
  code         String      @db.VarChar(17)
  type         ArchiveType
  observations String?     @db.Text
  documentDate DateTime?   @map("document_date")
  pdfUrl       String?     @map("pdf_url")
  pdfPath      String?     @map("pdf_path")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  createdById  String      @map("created_by_id")
  updatedById  String?     @map("updated_by_id")

  createdBy     User          @relation("ArchiveCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?         @relation("ArchiveUpdatedBy", fields: [updatedById], references: [id])
  grantors      Grantor[]
  beneficiaries Beneficiary[]

  // @@index([code]) — replaced by partial index in raw migration
  //   "archives_code_unique_active" UNIQUE WHERE deleted_at IS NULL
  //   "archives_code_idx"           WHERE deleted_at IS NULL
  @@index([type])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("archives")
}

model Grantor {
  id               String   @id @default(uuid())
  archiveId        String   @map("archive_id")
  nombresCompletos String   @map("nombres_completos")
  cedulaORuc       String   @map("cedula_o_ruc")
  nacionalidad     String
  createdAt        DateTime @default(now()) @map("created_at")

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([archiveId])
  @@index([cedulaORuc])
  @@map("grantors")
}

model Beneficiary {
  id               String   @id @default(uuid())
  archiveId        String   @map("archive_id")
  nombresCompletos String   @map("nombres_completos")
  cedulaORuc       String   @map("cedula_o_ruc")
  nacionalidad     String
  createdAt        DateTime @default(now()) @map("created_at")

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([archiveId])
  @@index([cedulaORuc])
  @@map("beneficiaries")
}

// ─── CLIENTS ──────────────────────────────────────────────────────────────────

model Client {
  id               String   @id @default(uuid())
  nombresCompletos String   @map("nombres_completos")
  cedulaORuc       String?  @map("cedula_o_ruc")
  nacionalidad     String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([cedulaORuc])
  @@map("clients")
}

// ─── LOGS ─────────────────────────────────────────────────────────────────────

model Log {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  endpoint   String?
  method     String?
  resource   String?
  resourceId String?  @map("resource_id")
  details    Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  statusCode Int?     @map("status_code")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("logs")
}

// ─── NOTARIES ─────────────────────────────────────────────────────────────────

model Notary {
  id                Int      @id @default(autoincrement())
  notaryName        String   @map("notary_name") @db.VarChar(200)
  notaryNumber      Int      @unique @map("notary_number")
  notaryOfficerName String   @map("notary_officer_name") @db.VarChar(200)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("notaries")
}

// ─── SETTINGS ─────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── NEWS ─────────────────────────────────────────────────────────────────────

model News {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(200)
  description String   @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("news")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  senderId    String           @map("sender_id")
  recipientId String           @map("recipient_id")
  subject     String           @db.VarChar(100)
  message     String           @db.VarChar(500)
  type        NotificationType
  sentAt      DateTime         @default(now()) @map("sent_at")
  read        Boolean          @default(false)

  sender User @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([sentAt])
  @@map("notifications")
}

// ─── UAFE FORMS ("Conozca a su Cliente") ──────────────────────────────────────

model UafeForm {
  id            String  @id @default(uuid())
  filledById    String? @map("filled_by_id")
  filledByName  String  @map("filled_by_name") @db.VarChar(200)
  filledByEmail String  @map("filled_by_email") @db.VarChar(200)
  filledByRole  String  @map("filled_by_role") @db.VarChar(50)
  templateId    String  @map("template_id") @db.VarChar(100)
  templateName  String  @map("template_name") @db.VarChar(200)

  // Contenido completo del formulario (UafeFormData). NUNCA guarda base64 de comprobantes.
  data Json

  // Campos desnormalizados desde `data` para filtrar en la lista sin escanear el JSON
  nacionalidad        String? @db.VarChar(120)
  nivelRiesgo         String? @map("nivel_riesgo") @db.VarChar(20)
  comparecienteNombre String? @map("compareciente_nombre") @db.VarChar(250)
  comparecienteId     String? @map("compareciente_id") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  filledBy     User?             @relation("UafeFilledBy", fields: [filledById], references: [id], onDelete: SetNull)
  comprobantes UafeComprobante[]

  @@index([filledById])
  @@index([createdAt])
  @@index([nacionalidad])
  @@index([nivelRiesgo])
  @@index([comparecienteId])
  @@map("uafe_forms")
}

model UafeComprobante {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  s3Key     String   @map("s3_key")
  createdAt DateTime @default(now()) @map("created_at")

  form UafeForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("uafe_comprobantes")
}

// ─── TASKS ────────────────────────────────────────────────────────────────────

model Task {
  id              String       @id @default(uuid())
  senderId        String       @map("sender_id")
  recipientId     String       @map("recipient_id")
  title           String       @db.VarChar(100)
  description     String       @db.VarChar(500)
  priority        TaskPriority
  dueDate         DateTime     @map("due_date") @db.Date
  status          TaskStatus   @default(PENDIENTE)
  attachmentName  String?      @map("attachment_name") @db.VarChar(255)
  attachmentSize  Int?         @map("attachment_size")
  attachmentMime  String?      @map("attachment_mime") @db.VarChar(100)
  createdAt       DateTime     @default(now()) @map("created_at")
  readByRecipient Boolean      @default(false) @map("read_by_recipient")

  sender    User @relation("TaskSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("TaskRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@map("tasks")
}
